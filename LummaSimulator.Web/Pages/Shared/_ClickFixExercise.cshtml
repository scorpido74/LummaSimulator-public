@model bool
<section id="clickfix-exercise" hidden data-attempt="" data-example-command="powershell.exe -NoProfile -Command &quot;&amp; { Write-Output 'Lumma awareness-demo' }&quot;" aria-label="@T["ExerciseLabel"]">
<form id="clickfix-antiforgery" method="post">@Html.AntiForgeryToken()</form>
<div class="cf-stage" id="clickfix-stage">
<section id="clickfix-warning" class="cf-window cf-warning" aria-labelledby="clickfix-warning-title"><div class="cf-titlebar"><span class="cf-demo-label"><local-text key="ExerciseLabel"></local-text></span><button id="clickfix-close" type="button" class="cf-close" aria-label="@T["ExerciseClose"]" data-i18n-aria-label="ExerciseClose">×</button></div><div class="cf-body"><h2 id="clickfix-warning-title"><local-text key="@(Model?"ExercisePrizeFailure":"ExerciseResultFailure")"></local-text></h2><p><local-text key="ExerciseUrgentHelp"></local-text></p><div class="cf-warning-actions"><button id="clickfix-copy" class="button button-outline" type="button"><local-text key="ExerciseCopy"></local-text></button><button id="clickfix-open" class="button button-primary" type="button">Win + R</button></div></div></section>
<section id="clickfix-run" class="cf-window cf-run" hidden aria-labelledby="run-title"><div class="cf-titlebar"><span class="cf-run-icon" aria-hidden="true">▣</span><span id="run-title"><local-text key="CfRun"></local-text></span><span class="cf-demo-label"><local-text key="ExerciseLabel"></local-text></span><button id="clickfix-run-close" type="button" class="cf-close" aria-label="@T["ExerciseClose"]" data-i18n-aria-label="ExerciseClose">×</button></div><div class="cf-body"><div class="cf-open-row"><label for="clickfix-command"><local-text key="CfField"></local-text></label><input id="clickfix-command" type="text" readonly value="" autocomplete="off" spellcheck="false" /></div><div class="cf-paste-actions"><button id="clickfix-paste" class="button button-outline" type="button" disabled><local-text key="ExercisePaste"></local-text></button></div><div class="cf-run-actions"><button id="clickfix-ok" type="button" class="button button-primary" disabled>OK</button><button id="clickfix-cancel" type="button" class="button button-outline"><local-text key="ExerciseMockCancel"></local-text></button></div></div></section>
</div>
<section id="clickfix-debrief" class="cf-window cf-debrief" hidden tabindex="-1"><div class="cf-body"><h2><local-text key="ExerciseCompleteTitle"></local-text></h2><p><local-text key="ExerciseSignals"></local-text></p><p><local-text key="ExerciseRealWarning"></local-text></p><button id="clickfix-back" class="button button-primary" type="button"><local-text key="ClickFixBack"></local-text></button><p id="clickfix-delivery" role="status"></p><button id="clickfix-retry" class="button button-outline" type="button" hidden><local-text key="ClickFixRetry"></local-text></button></div></section>
<noscript><p class="notice error"><local-text key="ClickFixNoScript"></local-text></p></noscript>
</section>
