@model LummaSimulator.Web.Services.Prizes.RoundProgress
<section class="panel" id="round-progress" data-status="@Model.Round.Status" data-url="@Url.Page("Index","Progress",new{id=Model.Round.EventId,roundId=Model.Round.GroupId})">
<h2>@Model.Round.EventName <span id="round-prizes-enabled"><local-text key="@(Model.PrizesEnabled?"EventPrizesOn":"EventPrizesOff")"></local-text></span> · <local-text key="PrizeRoundLabel"></local-text> @Model.Round.Number</h2>
<p><local-text key="PrizeSelection"></local-text>: <span id="round-prize-config">@if(Model.PrizeNames.Count==0){<local-text key="RoundNoPrizeConfigured"></local-text>}else{<local-text key="@(Model.PrizeSelection=="Fixed"?"PrizeFixed":"PrizeRandom")"></local-text><text>: @string.Join(", ",Model.PrizeNames)</text>}</span> · <a asp-page="/Presenter/Prizes/Event" asp-route-id="@Model.Round.EventId" asp-fragment="prize-settings"><local-text key="ViewPrizeSettings"></local-text></a></p>
<p><local-text key="PrizeRoundCapacity"></local-text>: <strong id="round-occupied">@Model.Round.Occupied / @Model.Round.Capacity</strong></p>
<p><local-text key="RoundCompleted"></local-text>: <strong id="round-completed">@Model.Completed</strong> · <span id="round-eligible-label" data-i18n="@(!Model.PrizesEnabled?"RoundActiveEntries":Model.Round.Status=="Open"?"RoundEligible":"RoundRemainingActive")">@T[!Model.PrizesEnabled?"RoundActiveEntries":Model.Round.Status=="Open"?"RoundEligible":"RoundRemainingActive"]</span>: <strong id="round-eligible">@Model.Eligible</strong> <span id="round-draw-disabled" hidden="@Model.PrizesEnabled">· <local-text key="RoundDrawDisabled"></local-text></span></p>
<div class="table-scroll"><table><thead><tr><th><local-text key="RoundAlias"></local-text></th><th><local-text key="RoundRegistered"></local-text></th><th><local-text key="RoundSignedIn"></local-text></th><th><local-text key="RoundDemoDone"></local-text></th><th><local-text key="RoundDrawStatus"></local-text></th></tr></thead><tbody id="round-participants">@foreach(var row in Model.Participants){<tr><td>@row.Alias</td><td><local-text key="@(row.Registered?"Yes":"No")"></local-text></td><td><local-text key="@(row.SignedIn?"Yes":"No")"></local-text></td><td><local-text key="@(row.Completed?"Yes":"No")"></local-text></td><td><local-text key="@row.Status"></local-text> @row.PrizeName @if(row.Reason is {} reason){<text>· </text><local-text key="@reason"></local-text>}</td></tr>}</tbody></table></div>
<p class="small-note"><local-text key="RoundRecordedSteps"></local-text></p>
<p class="small-note"><local-text key="RoundEligibilityNote"></local-text></p>
<p id="round-price-status" ><local-text key="@Model.PrizeReason"></local-text></p>
<p id="round-close-reason" hidden="@(Model.Round.Status!="Open"||Model.CloseReason==Model.PrizeReason)"><local-text key="@Model.CloseReason"></local-text></p>
<p id="round-zero" hidden="@(Model.Round.Status!="Open"||Model.Eligible!=0)"><local-text key="RoundNoWinner"></local-text></p>
<div id="round-winners" role="status">@foreach(var winner in Model.Round.Winners){<p>@winner.Alias · @winner.PrizeName</p>}@if(Model.Round.Status=="Closed"&&Model.Round.WinnerCount==0){<p><local-text key="RoundNoWinner"></local-text></p>}</div>
@if(Model.Round.Status=="Open"){
<form method="post" asp-page="/Presenter/Events/Index" id="close-round-form"><input type="hidden" name="operation" value="close-round"/><input type="hidden" name="kind" value="prize"/><input type="hidden" name="id" value="@Model.Round.EventId"/><input type="hidden" name="target" value="@Model.Round.GroupId"/>
<p><strong id="round-confirm-eligible">@Model.Eligible</strong> <local-text key="RoundCloseWarning"></local-text></p>
<label><input type="checkbox" name="confirmed" value="true" required/><local-text key="PresenterConfirm"></local-text></label><button class="button button-primary" id="close-round" disabled="@(!Model.CanClose)"><local-text key="@(Model.PrizeAvailable&&Model.Eligible>0&&Model.CanClose?"RoundCloseDraw":"RoundCloseOnly")"></local-text></button></form>
}
<p><a asp-page="/Presenter/Events/Index" asp-route-kind="prize" asp-route-id="@Model.Round.EventId"><local-text key="ShowCurrentRound"></local-text></a> · <a asp-page="/Presenter/Prizes/Event" asp-route-id="@Model.Round.EventId"><local-text key="PrizeDeliveryTitle"></local-text></a></p><p id="round-progress-status" role="status"></p>
</section>
